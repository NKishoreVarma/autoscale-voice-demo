rules_version = '2';
// Firestore rules for the AI Voice Calling Demo store.
//
// DESIGN: Call records contain personal data (recipient number, transcript,
// consent audit trail). They are written and read ONLY by the backend via the
// Firebase Admin SDK, which bypasses these rules. Therefore every direct client
// path is DENIED. This is deliberately the opposite of the marketing website's
// permissive public-create rules — do not copy those patterns here.
service cloud.firestore {
  match /databases/{database}/documents {

    match /voiceDemo_calls/{callId} {
      allow read, write: if false; // backend (Admin SDK) only
    }
    match /voiceDemo_audit/{auditId} {
      allow read, write: if false; // backend (Admin SDK) only
    }
    match /voiceDemo_webhookEvents/{eventId} {
      allow read, write: if false; // backend (Admin SDK) only
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
