# ============================================================================
# AI Voice Calling Demo — BACKEND environment (copy to .env; never commit .env)
# ============================================================================

NODE_ENV=development
PORT=8080

# Comma-separated admin emails authorized to initiate calls (SERVER-SIDE authz).
# These are the ONLY accounts the backend will accept, regardless of the client.
ADMIN_ALLOWLIST=you@example.com

# --- Firebase Admin (only needed when verifying real ID tokens / CALL_STORE=firestore)
FIREBASE_PROJECT_ID=
# Path to a service-account JSON. NEVER commit this file. Leave blank to use
# GOOGLE_APPLICATION_CREDENTIALS / Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Data store: 'memory' (default, no creds) or 'firestore'
CALL_STORE=memory

# --- Voice provider: 'mock' (default, no creds, TEST calls), 'retell', or 'sarvam'
VOICE_PROVIDER=mock

# --- Retell AI (only when VOICE_PROVIDER=retell) ----------------------------
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
RETELL_AGENT_ID=
# The verified outbound caller ID / from-number provisioned in Retell.
# For India (+91) this requires a compliant route — see docs/audit §4.2.
RETELL_FROM_NUMBER=
# Key used to verify x-retell-signature on webhooks (defaults to RETELL_API_KEY).
RETELL_WEBHOOK_API_KEY=

# --- Sarvam Voice Agents (only when VOICE_PROVIDER=sarvam) -------------------
# SARVAM_API_KEY is a SECRET — MUST stay empty here; set it only in Render. Never commit it.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://apps.sarvam.ai
# Org/workspace are embedded in the supplied endpoint (not secrets).
SARVAM_ORG_ID=01a13ef1-e00d-7269-ada5-a4c04d28ca74
SARVAM_WORKSPACE_ID=01a13ef1-e013-754a-b24a-7ebcc8ac6482
# Sample App ID from the dashboard snippet. UNVERIFIED — confirm in the Sarvam
# dashboard that this app is the intended Aria agent before any live call.
SARVAM_APP_ID=autoscale-e33748ce-5dbd
SARVAM_APP_VERSION=1
SARVAM_APP_TYPE=agent
SARVAM_CONNECTION_ID=9e7cbf64-e1-bb23e0c7-dbbf
SARVAM_AGENT_PHONE_NUMBER=+917965480920
# Optional app_overrides (omitted from the request when left empty):
SARVAM_INITIAL_BOT_MESSAGE=నమస్కారం! నేను Aria, AutoScale Demo నుంచి మాట్లాడుతున్న AI అసిస్టెంట్‌ని. మీకు ఎలా సహాయం చేయగలను?
# Leave empty until the correct entry state is confirmed (omitted from request when empty).
SARVAM_INITIAL_STATE_NAME=
SARVAM_TIMEOUT_MS=15000

# --- Editable demo identity + business context -----------------------------
# Loaded by config.demo and available to the agent. NOTE: for Sarvam, only
# variables the published agent DECLARES are consumed (the sample declares
# user_name); this business context primarily belongs in the Sarvam agent's
# prompt/knowledge in the dashboard. See docs/agent/ARIA_PROMPT.md.
DEMO_BUSINESS_NAME=AutoScale Demo
DEMO_AGENT_NAME=Aria
DEMO_CALL_PURPOSE=A short demonstration of our AI voice assistant
DEMO_BUSINESS_DESCRIPTION=AutoScale Demo showcases an AI voice assistant that can speak naturally, answer enquiries, qualify prospective customers, and collect relevant information for follow-up. This is a demonstration environment, and no real business commitments should be made.
DEMO_PRODUCT_DETAILS=AI voice assistant demonstration; conversational customer enquiries; lead qualification; customer requirement collection; call summary generation; callback requests where supported and confirmed by the system.
DEMO_BUSINESS_FAQS=What is AutoScale Demo? It demonstrates AI-powered voice conversations and customer enquiry handling. What can Aria do? Aria can explain the demonstration, ask relevant questions, and summarize the caller's requirements. Can Aria guarantee a callback? No. A callback can only be confirmed if the connected system explicitly confirms it. Are these real business offers? No verified offers or prices have been supplied. Can Aria answer in Telugu? Use Telugu when supported by the configured Sarvam agent, and English when requested.
DEMO_OFFERS_AND_PRICES=No verified prices, discounts, offers, payment terms, or promotional commitments have been supplied. Never invent prices or offers.
DEMO_CONTACT_DETAILS=No verified business phone number, office address, operating hours, or sales representative details have been supplied. Never invent contact information.
DEMO_ADDITIONAL_INSTRUCTIONS=You are Aria, the AI voice assistant for AutoScale Demo. Identify yourself honestly as an AI assistant. Speak naturally and professionally in Telugu by default and English when requested, provided the configured agent supports those languages. Ask one question at a time. Explain that this is a demonstration. Never invent business details, prices, offers, contact information, or commitments. Do not claim a callback or appointment is confirmed unless the system confirms it. Respect requests to end the conversation or stop contact. Collect only necessary information.

# --- Limits & spend controls ------------------------------------------------
RATE_LIMIT_PER_MINUTE=5
DAILY_CALL_LIMIT=25
MAX_CONCURRENT_CALLS=2
MAX_DAILY_SPEND_USD=10
ESTIMATED_USD_PER_MINUTE=0.12
ESTIMATED_MINUTES_PER_CALL=5

# --- Data retention ---------------------------------------------------------
DATA_RETENTION_DAYS=30

# --- CORS (comma-separated origins; blank allows all in dev) ----------------
CORS_ORIGINS=http://localhost:5173
