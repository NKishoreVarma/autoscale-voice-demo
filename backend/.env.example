# ============================================================================
# AI Voice Calling Demo — BACKEND environment (copy to .env; never commit .env)
# ============================================================================

NODE_ENV=development
PORT=8080

# Comma-separated admin emails authorized to initiate calls (SERVER-SIDE authz).
# These are the ONLY accounts the backend will accept, regardless of the client.
ADMIN_ALLOWLIST=you@example.com

# --- Firebase Admin (only needed when verifying real ID tokens / CALL_STORE=firestore)
FIREBASE_PROJECT_ID=
# Path to a service-account JSON. NEVER commit this file. Leave blank to use
# GOOGLE_APPLICATION_CREDENTIALS / Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Data store: 'memory' (default, no creds) or 'firestore'
CALL_STORE=memory

# --- Voice provider: 'mock' (default, no creds, TEST calls) or 'retell'
VOICE_PROVIDER=mock

# --- Retell AI (only when VOICE_PROVIDER=retell) ----------------------------
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
RETELL_AGENT_ID=
# The verified outbound caller ID / from-number provisioned in Retell.
# For India (+91) this requires a compliant route — see docs/audit §4.2.
RETELL_FROM_NUMBER=
# Key used to verify x-retell-signature on webhooks (defaults to RETELL_API_KEY).
RETELL_WEBHOOK_API_KEY=

# --- Editable demo identity + business context -----------------------------
# Injected into the "Aria" agent prompt as {{...}} dynamic variables.
# Leave content fields EMPTY unless you have VERIFIED info — the agent must not
# invent business facts. See docs/agent/ARIA_PROMPT.md.
DEMO_BUSINESS_NAME=AutoScale Demo
DEMO_AGENT_NAME=Aria
DEMO_CALL_PURPOSE=a short demonstration of our AI voice assistant
DEMO_BUSINESS_DESCRIPTION=
DEMO_PRODUCT_DETAILS=
DEMO_BUSINESS_FAQS=
DEMO_OFFERS_AND_PRICES=
DEMO_CONTACT_DETAILS=
DEMO_ADDITIONAL_INSTRUCTIONS=

# --- Limits & spend controls ------------------------------------------------
RATE_LIMIT_PER_MINUTE=5
DAILY_CALL_LIMIT=25
MAX_CONCURRENT_CALLS=2
MAX_DAILY_SPEND_USD=10
ESTIMATED_USD_PER_MINUTE=0.12
ESTIMATED_MINUTES_PER_CALL=5

# --- Data retention ---------------------------------------------------------
DATA_RETENTION_DAYS=30

# --- CORS (comma-separated origins; blank allows all in dev) ----------------
CORS_ORIGINS=http://localhost:5173
