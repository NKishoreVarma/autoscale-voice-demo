# ============================================================================
# AI Voice Calling Demo — FRONTEND environment (copy to .env; never commit .env)
# These are PUBLIC Firebase web-app config values (safe to expose to the browser).
# They are NOT secrets — real authorization happens server-side via ADMIN_ALLOWLIST.
# ============================================================================

VITE_API_BASE_URL=http://localhost:8080

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
